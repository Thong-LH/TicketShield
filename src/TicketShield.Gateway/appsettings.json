{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "identity-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/v1/auth{**catch-all}"
        }
      },
      "user-bank-accounts-route": {
        "ClusterId": "identity-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/v1/user-bank-accounts{**catch-all}"
        }
      },
      "core-route": {
        "ClusterId": "core-cluster",
        "CorsPolicy": "AllowFrontend",
        "Match": {
          "Path": "/api/v1/{**catch-all}"
        }
      },
      "sepay-webhook-route": {
        "ClusterId": "core-cluster",
        "Match": {
          "Path": "/api/webhooks/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "identity-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "core-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5003"
          }
        }
      }
    }
  }
}
