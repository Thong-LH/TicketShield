{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "HttpPort": 5006,
  "Redis": {
    "ConnectionString": "localhost:6379",
    "Enabled": true,
    "InstanceName": "ts:gw:"
  },
  "SessionToken": {
    "SecretKey": "TicketShield_MockOrganizer_AntiBot_SecretKey_2026_Secure!"
  },
  "AntiBotScoring": {
    "ModelPath": "models/anti_bot_model.onnx",
    "InputNodeName": "float_input",
    "OutputNodeName": "probabilities",
    "AllowThreshold": 0.35,
    "BlockThreshold": 0.75,
    "GuardTimeoutMs": 20
  },
  "ReverseProxy": {
    "Routes": {
      "organizer-catch-all": {
        "ClusterId": "organizer-cluster",
        "CorsPolicy": "AllowAll",
        "Match": {
          "Path": "{**catch-all}"
        }
      }
    },
    "Clusters": {
      "organizer-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5001"
          }
        }
      }
    }
  }
}
