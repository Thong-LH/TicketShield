COMPOSE_PROJECT_NAME=ticketshield

# Public DNS names. Point both A records to the VPS before starting Caddy.
API_DOMAIN=api.example.com
ORGANIZER_API_DOMAIN=organizer-api.example.com
ACME_EMAIL=admin@example.com

# Comma-separated browser origins. Do not add paths or a trailing slash.
CORS_ALLOWED_ORIGINS=https://fe-capstone-project-web.vercel.app

# Generate independent hexadecimal values with: openssl rand -hex 32
POSTGRES_USER=ticketshield
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
RABBITMQ_USER=ticketshield
RABBITMQ_PASSWORD=CHANGE_ME_RABBITMQ
REDIS_PASSWORD=CHANGE_ME_REDIS
JWT_SECRET=CHANGE_ME_JWT_MINIMUM_32_CHARACTERS
ORGANIZER_API_KEY=CHANGE_ME_ORGANIZER_API_KEY_MINIMUM_32_CHARACTERS
ORGANIZER_HMAC_KEY=CHANGE_ME_ORGANIZER_HMAC_KEY_MINIMUM_32_CHARACTERS
SETTLEMENT_SHARED_SECRET=CHANGE_ME_SETTLEMENT_SHARED_SECRET
ANTIBOT_SESSION_SECRET=CHANGE_ME_ANTIBOT_SESSION_SECRET
ANTIBOT_ADMIN_API_KEY=CHANGE_ME_ANTIBOT_ADMIN_API_KEY

JWT_ISSUER=TicketShield
JWT_AUDIENCE=TicketShieldApp
GOOGLE_CLIENT_ID=

# Optional email settings used by Identity and Core.
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_SENDER=no-reply@example.com
SMTP_SENDER_NAME=TicketShield
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional third-party integrations. Empty values disable or limit the feature.
BANKLOOKUP_API_KEY=
BANKLOOKUP_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=

# Optional SePay/VietQR configuration.
VIETQR_API_KEY=
VIETQR_WEBHOOK_SECRET=
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NUMBER=
VIETQR_ACCOUNT_NAME=

